APP_NAME=Leamate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain (no trailing slash)
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=claudestore
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@leamate.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=
AWS_ENDPOINT=
# "local" (default) or "s3" for each disk
MEDIA_DISK_DRIVER=local
PRIVATE_DISK_DRIVER=local

# --- Leamate: brand defaults (overridable in Admin → Settings) ---
BRAND_NAME=Leamate
BRAND_TAGLINE="Leather Goods & Accessories"
BRAND_EMAIL=info@leamate.com
BRAND_PHONE="(+92) 331-4657496"
BRAND_ADDRESS="Capital Road, Sialkot, Pakistan"
BRAND_REFERENCE_PREFIX=LM

# --- Commercial defaults (integer cents / basis points; overridable in Admin → Settings) ---
SALES_NOTIFICATION_EMAIL=info@leamate.com
STORE_TAX_RATE_BPS=0
STORE_SHIPPING_FLAT_CENTS=0
STORE_MIN_ORDER_VALUE_CENTS=0
QUOTE_RATE_LIMIT_PER_HOUR=5

# --- Optional image provider: "null" (manual workflow) or "removebg" ---
IMAGE_PROVIDER=null
REMOVEBG_API_KEY=

# Production only: password for the seeded admin (never printed in production)
# SEED_ADMIN_PASSWORD=

# --- Website chatbot (Admin → Settings → Chatbot). Server-side only; never exposed to browsers ---
# Without credentials the chatbot (if enabled) shows an "offline" contact panel.
# Provider: cloudflare (default) | anthropic | null. Never commit real values.
AI_DEFAULT_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Optional alternative provider
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_TIMEOUT=30
ASSISTANT_RATE_PER_MINUTE=8
ASSISTANT_RATE_PER_DAY=80
