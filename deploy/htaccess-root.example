# Copy to public_html/.htaccess ONLY when the document root is the Laravel project root
# (public_html) and cannot be pointed at public_html/public. Merge by hand if a .htaccess
# already exists there. See deploy/README.md.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles or dot-directories (.env, .git, .deploy …), except ACME challenges.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Serve everything from public/ so app code, storage and config are unreachable.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback if mod_rewrite is unavailable: deny dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
