# Hostinger shared hosting: the repo is deployed into public_html, so send
# every request into Laravel's public/ directory.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles (.env, .git) from the project root.
    RewriteRule (^|/)\. - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
